{
  "name": "@biaomai/workbench",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx server/api-server.ts",
    "dev:web": "vite",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "vite build",
    "dist:mac": "vite build && npx electron-builder --mac --config electron-builder.yml",
    "dist:win": "vite build && npx electron-builder --win --config electron-builder.yml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@biaomai/ai-browser": "workspace:*",
    "@biaomai/plugin-runtime": "workspace:*",
    "@biaomai/plugin-sdk": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "vite": "^8.3.8"
  }
}
