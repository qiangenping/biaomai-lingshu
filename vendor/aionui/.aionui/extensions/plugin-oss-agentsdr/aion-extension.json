{
  "name": "plugin-oss-agentsdr",
  "displayName": "AgentSDR 全渠道触达插件 (Email + LinkedIn + WhatsApp)",
  "version": "1.0.0",
  "description": "封装 MIT 开源理念 AgentSDR：打通 Email + LinkedIn + WhatsApp 外贸三剑客协同触达与统一线索状态推进。",
  "author": "OpenGrowth & AgentSDR (MIT)",
  "license": "MIT",
  "category": "leadgen",
  "i18n": {
    "localesDir": "i18n",
    "defaultLocale": "en-US"
  },
  "permissions": {
    "fsReadPaths": [],
    "fsWritePaths": [],
    "netDomains": [
      "linkedin.com",
      "web.whatsapp.com"
    ],
    "browserCdp": true,
    "shellExec": false,
    "imNotify": true,
    "defaultApproval": "always-ask",
    "alwaysAskActions": [
      "send_whatsapp_message",
      "send_linkedin_note"
    ]
  },
  "contributes": {
    "skills": [
      {
        "name": "agentsdr-omnichannel",
        "description": {
          "zh-CN": "AgentSDR 全渠道触达：Email + LinkedIn + WhatsApp 协同开发",
          "en-US": "Email + LinkedIn + WhatsApp coordinated outreach skill"
        },
        "file": "skills/agentsdr-omnichannel/SKILL.en.md",
        "localizedFiles": {
          "zh-CN": "skills/agentsdr-omnichannel/SKILL.zh.md",
          "en-US": "skills/agentsdr-omnichannel/SKILL.en.md"
        }
      }
    ]
  }
}