{
  "name": "plugin-oss-twenty-crm",
  "displayName": "Twenty / Atomic 开源 CRM 连接器插件",
  "version": "1.0.0",
  "description": "对接 GitHub 热门开源 CRM（twentyhq/twenty 与 marmelab/atomic-crm），支持本地看板推进与 REST API 一键同步线索和商机。",
  "author": "BiaoMai Lingshu Team",
  "license": "Apache-2.0",
  "category": "leadgen",
  "i18n": {
    "localesDir": "i18n",
    "defaultLocale": "en-US"
  },
  "permissions": {
    "fsReadPaths": [
      "./exports"
    ],
    "fsWritePaths": [
      "./exports"
    ],
    "netDomains": [
      "*"
    ],
    "browserCdp": true,
    "shellExec": false,
    "imNotify": false,
    "defaultApproval": "ask-once",
    "alwaysAskActions": [
      "sync_external_crm"
    ]
  },
  "contributes": {
    "skills": [
      {
        "name": "twenty-crm-sync",
        "description": "Sync qualified leads and opportunities to Twenty CRM or Atomic CRM",
        "file": "skills/twenty-crm-sync/SKILL.en.md",
        "localizedFiles": {
          "zh-CN": "skills/twenty-crm-sync/SKILL.zh.md",
          "en-US": "skills/twenty-crm-sync/SKILL.en.md"
        }
      }
    ]
  }
}