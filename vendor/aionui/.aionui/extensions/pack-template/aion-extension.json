{
  "name": "pack-template",
  "displayName": "自定义行业插件模板包",
  "version": "1.0.0",
  "description": "5 分钟快速构建本地办公或 ToB 垂直行业应用包（如文档批处理、招投标审标、ERP/CRM 对接）的最小可运行模板",
  "author": "Community Contributor",
  "license": "Apache-2.0",
  "category": "local-office",
  "i18n": {
    "localesDir": "i18n",
    "defaultLocale": "en-US"
  },
  "permissions": {
    "fsReadPaths": [
      "./workspace"
    ],
    "fsWritePaths": [
      "./workspace/output"
    ],
    "netDomains": [],
    "browserCdp": false,
    "shellExec": false,
    "imNotify": false,
    "defaultApproval": "ask-once",
    "alwaysAskActions": []
  },
  "contributes": {
    "skills": [
      {
        "name": "sample-office-skill",
        "description": {
          "zh-CN": "示例本地办公技能",
          "en-US": "Sample local office automation skill"
        },
        "file": "skills/SKILL.en.md",
        "localizedFiles": {
          "zh-CN": "skills/SKILL.zh.md",
          "en-US": "skills/SKILL.en.md"
        }
      }
    ],
    "assistants": [
      {
        "id": "sample-office-assistant",
        "name": "本地办公示例助手",
        "description": "演示如何扩展本地文档处理与自定义画布",
        "presetAgentType": "opencode",
        "contextFile": "skills/SKILL.en.md",
        "enabledSkills": [
          "sample-office-skill"
        ],
        "defaultCanvasId": "sample-canvas"
      }
    ],
    "canvases": [
      {
        "id": "sample-canvas",
        "title": {
          "zh-CN": "示例画布",
          "en-US": "Sample Canvas"
        },
        "icon": "file-text",
        "componentPath": "canvases/SampleCanvas.tsx",
        "defaultForAssistants": [
          "sample-office-assistant"
        ]
      }
    ]
  }
}