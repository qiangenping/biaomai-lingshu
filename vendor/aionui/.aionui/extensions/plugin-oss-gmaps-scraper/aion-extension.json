{
  "name": "plugin-oss-gmaps-scraper",
  "displayName": "谷歌地图批量获客插件 (google-maps-scraper)",
  "version": "1.0.0",
  "description": "封装开源 MIT 项目 omkarcloud/google-maps-scraper：按行业与国家/城市批量采集海外商家名称、官网、电话与评分，免付费 Maps API。",
  "author": "OpenGrowth & Omkar Cloud (MIT)",
  "license": "MIT",
  "category": "leadgen",
  "i18n": {
    "localesDir": "i18n",
    "defaultLocale": "en-US"
  },
  "permissions": {
    "fsReadPaths": [
      "./exports"
    ],
    "fsWritePaths": [
      "./exports"
    ],
    "netDomains": [
      "google.com",
      "localhost"
    ],
    "browserCdp": true,
    "shellExec": false,
    "imNotify": false,
    "defaultApproval": "ask-once",
    "alwaysAskActions": [
      "export_prospects"
    ]
  },
  "contributes": {
    "skills": [
      {
        "name": "gmaps-bulk-scraper",
        "description": {
          "zh-CN": "Google 地图批量获客：按行业与国家提取商家名称、官网与电话",
          "en-US": "Bulk Google Maps B2B prospect extraction skill"
        },
        "file": "skills/gmaps-bulk-scraper/SKILL.en.md",
        "localizedFiles": {
          "zh-CN": "skills/gmaps-bulk-scraper/SKILL.zh.md",
          "en-US": "skills/gmaps-bulk-scraper/SKILL.en.md"
        }
      }
    ]
  }
}