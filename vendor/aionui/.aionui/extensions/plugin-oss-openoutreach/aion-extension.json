{
  "name": "plugin-oss-openoutreach",
  "displayName": "OpenOutreach AI 寻客插件 (eracle/OpenOutreach)",
  "version": "1.0.0",
  "description": "封装 Apache-2.0 开源项目 eracle/OpenOutreach：根据我方产品卖点自动评估目标企业 ICP 匹配度并生成个性化开发信破冰理由。",
  "author": "OpenGrowth & OpenOutreach (Apache-2.0)",
  "license": "Apache-2.0",
  "category": "leadgen",
  "i18n": {
    "localesDir": "i18n",
    "defaultLocale": "en-US"
  },
  "permissions": {
    "fsReadPaths": [],
    "fsWritePaths": [],
    "netDomains": [
      "*"
    ],
    "browserCdp": false,
    "shellExec": false,
    "imNotify": false,
    "defaultApproval": "always-ask",
    "alwaysAskActions": [
      "send_smtp_email"
    ]
  },
  "contributes": {
    "skills": [
      {
        "name": "openoutreach-icp",
        "description": {
          "zh-CN": "OpenOutreach AI 寻客：客户画像匹配评分与多语种开发信破冰",
          "en-US": "AI ICP fit scoring & cold outreach drafting skill"
        },
        "file": "skills/openoutreach-icp/SKILL.en.md",
        "localizedFiles": {
          "zh-CN": "skills/openoutreach-icp/SKILL.zh.md",
          "en-US": "skills/openoutreach-icp/SKILL.en.md"
        }
      }
    ]
  }
}