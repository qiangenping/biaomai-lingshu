{
  "name": "biaomai-operations-platform",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source extensible AI desktop workbench (micro-kernel + hot-pluggable skills/MCP/canvas packs) with V1.0 global lead-generation suite.",
  "scripts": {
    "dev:aionui": "export PATH=\"$HOME/.bun/bin:$PATH\" && export AIONUI_BACKEND_BIN=\"$(pwd)/vendor/aionui/bin/aioncore\" && cd vendor/aionui && env -u ELECTRON_RUN_AS_NODE bun run start",
    "dev:workbench": "pnpm --filter @biaomai/workbench dev",
    "dev:billing": "pnpm --filter @biaomai/billing-gateway dev",
    "build:workbench": "pnpm --filter @biaomai/workbench build",
    "dist:mac": "pnpm --filter @biaomai/workbench dist:mac",
    "dist:win": "pnpm --filter @biaomai/workbench dist:win",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:packs": "node scripts/verify-packs.mjs",
    "install:aionui-packs": "node scripts/install-to-aionui.mjs",
    "verify:all": "pnpm verify:i18n && pnpm verify:licenses && pnpm verify:packs && pnpm typecheck && pnpm test && pnpm build:workbench",
    "bootstrap": "bash scripts/bootstrap.sh",
    "docker:up": "docker compose -f vendor/aitoearn/docker-compose.yml up -d",
    "docker:down": "docker compose -f vendor/aitoearn/docker-compose.yml down"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.10.0"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}